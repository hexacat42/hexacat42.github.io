---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import { getLocaleFromUrl } from '../i18n/utils';
import { getContent } from '../i18n/content';
import { hessen } from '../data/hessen';
import { images } from '../lib/images';

const locale = getLocaleFromUrl(Astro.url);
const c = getContent(locale);
const h = hessen[locale];
const mailto = `mailto:${c.email}?subject=${encodeURIComponent(h.pilot.subject)}`;
---
<Base title={h.meta.title} description={h.meta.description}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="eyebrow">{h.hero.eyebrow}</p>
        <h1>{h.hero.title}</h1>
        <p class="hero__lead">{h.hero.lead}</p>
        <div class="hero__cta">
          <a class="btn" href={mailto}>{h.hero.cta}</a>
          <a class="btn btn-ghost" href={h.pdfHref} download target="_blank" rel="noopener">
            <Icon name="book" size={16} /> {h.hero.ctaPdf}
          </a>
        </div>
      </div>
      <figure class="hero__media">
        <Image src={images.showcase} alt="Poetry Cam" widths={[420, 640, 900]}
               sizes="(max-width: 880px) 92vw, 440px" loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <!-- Curriculum fit -->
  <Section id="bildungsweg" eyebrow={h.fit.eyebrow} title={h.fit.title} intro={h.fit.intro} alt>
    <ol class="stages">
      {h.fit.stages.map((s) => (
        <li class="stage card">
          <p class="label-muted">{s.grade} · {s.start}</p>
          <h3>{s.name}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <p class="source"><a href={h.fit.source} target="_blank" rel="noopener">{h.fit.sourceLabel}</a></p>
  </Section>

  <!-- Lesson -->
  <Section id="unterricht" eyebrow={h.lesson.eyebrow} title={h.lesson.title} intro={h.lesson.intro}>
    <ol class="phases">
      {h.lesson.phases.map((p) => (
        <li class="phase">
          <span class="phase__n label-muted">{p.n}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
    <div class="two-col">
      <div>
        <h3>{h.lesson.questionsTitle}</h3>
        <ul class="ticks">
          {h.lesson.questions.map((q) => <li><Icon name="quill" size={16} />{q}</li>)}
        </ul>
      </div>
      <div>
        <h3>{h.competences.title}</h3>
        <ul class="ticks">
          {h.competences.items.map((q) => <li><Icon name="arrow" size={16} />{q}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <!-- Privacy -->
  <Section id="datenschutz" eyebrow={h.privacy.eyebrow} title={h.privacy.title} intro={h.privacy.intro} alt>
    <div class="facts">
      {h.privacy.facts.map((f) => (
        <div class="fact">
          <span class="fact__icon"><Icon name="shield" size={22} /></span>
          <div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        </div>
      ))}
    </div>
    <p class="honest">{h.privacy.honest}</p>
    <div class="docs card">
      <h3>{h.privacy.docsTitle}</h3>
      <ul class="ticks">
        {h.privacy.docs.map((d) => <li><Icon name="certificate" size={16} />{d}</li>)}
      </ul>
      <p class="docs__note">{h.privacy.docsNote}</p>
    </div>
  </Section>

  <!-- Pilot -->
  <Section id="pilot" eyebrow={h.pilot.eyebrow} title={h.pilot.title} center narrow>
    <p class="pilot__body">{h.pilot.body}</p>
    <ul class="ticks pilot__points">
      {h.pilot.points.map((pt) => <li><Icon name="arrow" size={16} />{pt}</li>)}
    </ul>
    <div class="pilot__cta">
      <a class="btn" href={mailto}>{h.pilot.cta}</a>
    </div>
  </Section>
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .hero__inner { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .hero__lead { font-size: 1.15rem; color: var(--color-ink-soft); max-width: 44ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .hero__cta :global(svg) { flex: none; }
  .hero__media img { width: 100%; height: auto; border-radius: var(--radius-card); box-shadow: 0 12px 34px rgba(28,26,21,.16); }
  @media (max-width: 880px) { .hero__inner { grid-template-columns: 1fr; } .hero__media { order: -1; max-width: 30rem; } }

  .stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .stage h3 { margin: 0.3rem 0 0.5rem; }
  .stage p:last-child { color: var(--color-ink-soft); margin: 0; }
  .stage .label-muted { margin: 0; }
  @media (max-width: 860px) { .stages { grid-template-columns: 1fr; } }
  .source { margin: 1.25rem 0 0; font-size: 0.85rem; }

  .phases { list-style: none; margin: 0 0 2.5rem; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .phase { border-top: 2px dotted var(--color-rule); padding-top: 1rem; }
  .phase__n { display: block; margin-bottom: 0.4rem; }
  .phase h3 { font-size: 1.15rem; margin: 0 0 0.4rem; }
  .phase p { color: var(--color-ink-soft); font-size: 0.95rem; margin: 0; }
  @media (max-width: 900px) { .phases { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .phases { grid-template-columns: 1fr; } }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  .two-col h3 { margin-bottom: 0.25rem; }
  @media (max-width: 760px) { .two-col { grid-template-columns: 1fr; gap: 1.75rem; } }

  .ticks { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
  .ticks li { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem; align-items: start; color: var(--color-ink-soft); }
  .ticks :global(svg) { color: var(--color-accent); margin-top: 0.2rem; }

  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 2.5rem; }
  .fact { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; }
  .fact__icon {
    display: grid; place-items: center; width: 3rem; height: 3rem;
    border: 1.5px dashed var(--color-rule); border-radius: 50%; color: var(--color-accent);
  }
  .fact h3 { font-size: 1.15rem; margin: 0.2rem 0 0.3rem; }
  .fact p { color: var(--color-ink-soft); margin: 0; }
  @media (max-width: 760px) { .facts { grid-template-columns: 1fr; } }

  .honest {
    margin: 2rem 0; padding: 1rem 1.2rem; border-left: 3px solid var(--color-accent);
    background: var(--color-poem-bg); border-radius: var(--radius-media); color: var(--color-ink);
  }
  .docs h3 { margin-bottom: 0; }
  .docs__note { margin: 1rem 0 0; font-size: 0.92rem; color: var(--color-ink-soft); }

  .pilot__body { color: var(--color-ink-soft); text-align: center; }
  .pilot__points { max-width: 34rem; margin-inline: auto; }
  .pilot__cta { display: flex; justify-content: center; margin-top: 2rem; }
</style>
