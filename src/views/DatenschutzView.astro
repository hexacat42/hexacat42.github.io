---
import Base from '../layouts/Base.astro';
import { getLocaleFromUrl, localizePath } from '../i18n/utils';
import { getContent } from '../i18n/content';

const locale = getLocaleFromUrl(Astro.url);
const c = getContent(locale);
// NOTE: template reflecting this site's actual behaviour (static host, no
// analytics/cookies, click-to-load LinkedIn). Review with a lawyer before launch.
---
<Base title={c.footer.datenschutz} description="Datenschutzerklärung" noindex>
  <section class="section">
    <div class="container container--narrow legal">
      <a class="btn btn-ghost backlink" href={localizePath('/', locale)}>{c.common.backHome}</a>
      <h1>{c.footer.datenschutz}</h1>

      {locale === 'de' ? (
        <>
          <h2>Verantwortlicher</h2>
          <p>Georg Klassen, München · E-Mail: <a href={`mailto:${c.email}`}>{c.email}</a>
             (vollständige Anschrift siehe <a href={localizePath('/impressum', 'de')}>Impressum</a>).</p>

          <h2>Hosting</h2>
          <p>Diese Website wird als statische Seite über GitHub Pages (GitHub, Inc., USA) bereitgestellt.
             Beim Aufruf verarbeitet der Hoster technisch notwendige Server-Logdaten (u. a. IP-Adresse,
             Zeitpunkt, angeforderte Datei) zur Auslieferung und Sicherheit. Rechtsgrundlage ist unser
             berechtigtes Interesse an einem sicheren Betrieb (Art. 6 Abs. 1 lit. f DSGVO).</p>

          <h2>Cookies &amp; Analyse</h2>
          <p>Diese Website setzt keine Cookies für Tracking oder Statistik und bindet keine Analyse-Werkzeuge
             ein. Ihre gewählte Sprache und das Farbschema (hell/dunkel) werden – sofern Sie sie ändern –
             lokal in Ihrem Browser gespeichert und nicht an uns übermittelt.</p>

          <h2>Kontaktaufnahme</h2>
          <p>Wenn Sie uns per E-Mail schreiben, verarbeiten wir Ihre Angaben ausschließlich zur Bearbeitung
             Ihrer Anfrage (Art. 6 Abs. 1 lit. b bzw. f DSGVO).</p>

          <h2>Externe Dienste &amp; Social Media</h2>
          <p>Diese Website bindet keine Inhalte sozialer Netzwerke (z. B. LinkedIn) ein und lädt keine
             externen Skripte. Es findet keine automatische Verbindung zu Drittanbietern statt.</p>

          <h2>Geteilte Poetry-Cam-Seiten</h2>
          <p>Das Teilen eines Moments erfolgt über einen separaten Dienst (cam-assets.digilyze.com) und nur
             mit Ihrer ausdrücklichen Zustimmung am Gerät. Geteilte Inhalte sind maximal 48 Stunden abrufbar
             und werden danach automatisch gelöscht; es werden keine Konten angelegt und keine personenbezogenen
             Daten erhoben.</p>

          <h2>Ihre Rechte</h2>
          <p>Sie haben das Recht auf Auskunft, Berichtigung, Löschung, Einschränkung der Verarbeitung,
             Datenübertragbarkeit sowie Widerspruch. Zudem besteht ein Beschwerderecht bei einer
             Aufsichtsbehörde.</p>
        </>
      ) : (
        <>
          <p class="note">This English text is a courtesy translation; the legally binding version is the
             German <a href={localizePath('/datenschutz', 'de')}>Datenschutzerklärung</a>.</p>
          <h2>Controller</h2>
          <p>Georg Klassen, Munich · Email: <a href={`mailto:${c.email}`}>{c.email}</a>
             (full address in the <a href={localizePath('/impressum', 'en')}>imprint</a>).</p>
          <h2>Hosting</h2>
          <p>This static website is served via GitHub Pages (GitHub, Inc., USA). The host processes
             technically necessary server log data (e.g. IP address, time, requested file) for delivery and
             security, based on our legitimate interest (Art. 6(1)(f) GDPR).</p>
          <h2>Cookies &amp; analytics</h2>
          <p>This site sets no tracking or statistics cookies and embeds no analytics tools. Your chosen
             language and colour scheme are stored locally in your browser if you change them, and are not
             transmitted to us.</p>
          <h2>Contact</h2>
          <p>If you email us, we process your details solely to handle your enquiry (Art. 6(1)(b)/(f) GDPR).</p>
          <h2>External services &amp; social media</h2>
          <p>This website embeds no social-media content (e.g. LinkedIn) and loads no external scripts. No
             automatic connection to third parties takes place.</p>
          <h2>Shared Poetry Cam pages</h2>
          <p>Sharing a moment uses a separate service (cam-assets.digilyze.com) and only with your explicit
             consent on the device. Shared content is available for at most 48 hours and is then deleted
             automatically; no accounts are created and no personal data is collected.</p>
          <h2>Your rights</h2>
          <p>You have the right to access, rectification, erasure, restriction, data portability and
             objection, as well as the right to lodge a complaint with a supervisory authority.</p>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  .backlink { margin-bottom: 1.5rem; }
  .legal h2 { font-size: 1.25rem; margin-top: 2rem; }
  .legal p { color: var(--color-ink-soft); }
  .legal .note { font-size: 0.9rem; }
</style>
