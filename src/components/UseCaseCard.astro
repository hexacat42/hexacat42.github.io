---
import Icon from './Icon.astro';
interface Props { title: string; tagline: string; icon: string; href: string; cta: string; }
const { title, tagline, icon, href, cta } = Astro.props;
---
<article class="usecase card">
  <span class="usecase__icon"><Icon name={icon} size={26} /></span>
  <h3>{title}</h3>
  <p>{tagline}</p>
  <a class="btn btn-ghost usecase__cta" href={href}>{cta}<Icon name="arrow" size={16} /></a>
</article>

<style>
  .usecase { display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; }
  .usecase__icon {
    display: inline-grid; place-items: center; width: 3rem; height: 3rem;
    border-radius: 50%; border: 1.5px solid var(--color-rule); color: var(--color-accent);
    margin-bottom: 0.3rem;
  }
  .usecase h3 { margin: 0; }
  .usecase p { color: var(--color-ink-soft); margin: 0; flex: 1; }
  .usecase__cta { margin-top: 0.5rem; }
</style>
