---
import '../styles/tokens.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocaleFromUrl, htmlLang } from '../i18n/utils';
import { getContent } from '../i18n/content';

interface Props { title: string; description?: string; image?: string; noindex?: boolean; }
const { title, description, image, noindex = false } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const c = getContent(locale);
---
<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description ?? c.metaDescription} image={image} noindex={noindex} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{c.common.skip}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
