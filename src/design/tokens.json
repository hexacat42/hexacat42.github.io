{
  "$schema": "./tokens.schema.json",
  "$comment": "Poetry Cam — canonical design tokens. THE single shared source of truth for the ecosystem. Each project generates its own artifact from this file (CSS custom properties, a Qt palette, etc.) — never hand-edit a consuming repo's compiled styles. IMPORTANT: the three surfaces currently DIVERGE on purpose (device = navy, web/share = warm paper). `core` holds only what is genuinely common; per-surface values live under `surfaces`. Values below mirror each repo's CURRENT (post-revert) palette so day-one generation changes nothing. Unifying more into `core` is a deliberate future decision — see DESIGN.md.",
  "meta": {
    "version": "0.0.0",
    "updated": "2026-08-23"
  },

  "core": {
    "font": {
      "serif": "Georgia, \"Times New Roman\", serif",
      "sans": "-apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "mono": "ui-monospace, \"SF Mono\", Menlo, \"DejaVu Sans Mono\", monospace"
    },
    "radius": {
      "control": "8px",
      "media": "10px",
      "card": "14px"
    }
  },

  "surfaces": {
    "web": {
      "$note": "poetry-cam-www — homepage (HTML5 UP Stellar / SCSS). PROVISIONAL: reflects the current uncommitted 'Poetic Print' reskin (warm paper + patent-stamp accent). Not yet committed; may change.",
      "color": {
        "page-bg":  { "light": "#e7e1d4", "dark": "#131109" },
        "card-bg":  { "light": "#fbf8f2", "dark": "#211d15" },
        "poem-bg":  { "light": "#f1ebdd", "dark": "#191510" },
        "ink":      { "light": "#1c1a15", "dark": "#f1ece1" },
        "ink-soft": { "light": "#5b5346", "dark": "#bcb4a4" },
        "ink-faint":{ "light": "#8a8073", "dark": "#8f877a" },
        "brand":    { "light": "#857c6f", "dark": "#a49a8a" },
        "rule":     { "light": "rgba(28,26,21,0.12)", "dark": "rgba(255,255,255,0.13)" },
        "accent":       { "light": "#9d3b2f", "dark": "#d97a5f" },
        "accent-ink":   { "light": "#7d2f26", "dark": "#e79880" },
        "success":  { "light": "#4f7a3f", "dark": "#7ba362" },
        "warning":  { "light": "#b5852a", "dark": "#d6a94a" },
        "error":    { "light": "#b1442f", "dark": "#e0795f" }
      }
    },

    "share": {
      "$note": "poetry-cam-server — public 48h share pages (PHP). Mirrors its current design/tokens.json (warm paper, no accent).",
      "color": {
        "page-bg":  { "light": "#e9e4d8", "dark": "#131109" },
        "card-bg":  { "light": "#fffdf9", "dark": "#211d15" },
        "poem-bg":  { "light": "#f3eee4", "dark": "#191510" },
        "ink":      { "light": "#1b1915", "dark": "#f1ece1" },
        "ink-soft": { "light": "#524c40", "dark": "#bcb4a4" },
        "brand":    { "light": "#857c6f", "dark": "#a49a8a" },
        "rule":     { "light": "rgba(0,0,0,0.10)", "dark": "rgba(255,255,255,0.12)" }
      }
    },

    "device": {
      "$note": "poetry-cam — Raspberry Pi PyQt5 touch UI. Mirrors its current ui/theme_tokens.json (cool navy/blue). Single theme (no dark mode).",
      "color": {
        "bg": "#F4F2EE",
        "surface": "#FFFFFF",
        "surface_alt": "#EEF3F8",
        "text": "#1D2A38",
        "muted": "#6C7886",
        "accent": "#2D74C4",
        "accent_hover": "#235EA1",
        "warning": "#E2B22D",
        "success": "#3BAA66",
        "error": "#D24C44",
        "line": "#D8E0E7",
        "header_bg": "#23364B",
        "header_text": "#F8FBFF",
        "disabled_bg": "#A7AAB0",
        "disabled_text": "#ECEEF2",
        "footer_bg": "#F4F2EE",
        "power": "#D95C45",
        "live_badge": "#FF5252",
        "section_muted": "#55606B",
        "divider": "#E4EAF0",
        "field_bg": "#F5F8FB",
        "button_border": "#B6C0CB",
        "button_disabled_text": "#9AA7B4",
        "bulb_ok": "#2E9E4F",
        "bulb_checking": "#C9A227",
        "pulse_highlight": "#FFE8A3",
        "pulse_border_dark": "#B57A00"
      }
    }
  }
}
